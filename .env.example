# WAJIB. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
FACE_API_KEY=

# jumlah proses uvicorn (tiap proses ~180 MB RAM) & thread OpenCV per proses
WEB_CONCURRENCY=1
FACE_THREADS=2

# batas input
FACE_MAX_IMAGE_BYTES=3145728
FACE_MAX_SIDE=1280

# kualitas foto
FACE_DET_SCORE=0.8
FACE_MIN_FACE_PX=100
FACE_MIN_BLUR=40
FACE_MIN_BRIGHTNESS=50
FACE_MAX_BRIGHTNESS=215
FACE_MAX_YAW=0.35

# anti-spoofing (skor wajah asli minimal)
FACE_ANTISPOOF=true
FACE_SPOOF_THRESHOLD=0.6

# threshold cosine untuk endpoint /compare
FACE_MATCH_THRESHOLD=0.363
